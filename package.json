{
  "name": "payments-qa-framework",
  "private": true,
  "type": "module",
  "workspaces": [
    "framework",
    "payref",
    "wallet-sim"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:up": "docker compose up --wait",
    "db:down": "docker compose down",
    "test": "node tools/test.ts",
    "test:1.0": "node tools/test.ts --payref 1.0",
    "report": "node tools/report.ts",
    "test:unit": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run test:unit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
